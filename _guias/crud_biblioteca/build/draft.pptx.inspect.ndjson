{"kind":"textbox","id":"sh/32103e9w","slideIndex":14,"position":{"left":64,"top":225,"width":500,"height":370},"text":"Tiempo: 8 minutos\n\nAna cambia su correo a ana.soto@universidad.cl.\nExplica la ruta, el método y la vista.\nIndica qué registros deben actualizarse.","geometry":"rect","lineWidth":0,"style":{"fontSize":30,"typeface":"Arial","color":"#172D39","alignment":"left"}}
