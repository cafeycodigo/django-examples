{"kind":"textbox","id":"sh/2d0zmd8n","slideIndex":11,"position":{"left":64,"top":225,"width":500,"height":370},"text":"Primero buscamos por su ID.\nGET muestra los datos actuales.\nPOST valida y guarda cambios.\n\nEl ID se mantiene.","geometry":"rect","lineWidth":0,"style":{"fontSize":30,"typeface":"Arial","color":"#172D39","alignment":"left"}}
